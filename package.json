{
  "name": "json-viewer-react",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prepare": "git rev-parse --git-dir > /dev/null 2>&1 && lefthook install || true",
    "start": "next start",
    "format": "biome format --write .",
    "lint": "eslint .",
    "lint:biome": "biome lint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "biome check . && eslint . && tsc --noEmit && vitest run",
    "fix": "biome check --write .",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@lezer/highlight": "^1.2.5",
    "@uiw/codemirror-themes": "^4.25.12",
    "@uiw/react-codemirror": "^4.25.12",
    "@vercel/analytics": "^2.0.1",
    "d3": "^7.9.0",
    "i18next": "^26.5.4",
    "i18next-browser-languagedetector": "^8.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "notyf": "^3.10.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.0",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/eslint-parser": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.7",
    "@biomejs/biome": "2.6.2",
    "@next/eslint-plugin-next": "16.4.2",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/d3": "^7.4.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "lefthook": "2.2.2",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "24.x"
  }
}
