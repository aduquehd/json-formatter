# Copy this file to .env.local and set only what you need.
# The app builds and runs with none of these set.
#
# All JSON processing happens in the browser; your content is never sent
# anywhere, and no analytics setting changes that.

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX.
# Optional. Leave empty and no Google script is loaded and no consent banner is
# shown. When set, GA runs behind Consent Mode: analytics_storage starts denied,
# so no cookies are written until the visitor accepts in the banner.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Vercel Web Analytics needs no variable — it is enabled per-project from the
# Vercel dashboard, sets no cookies, and runs regardless of the consent choice.
