# Copy this file to .env.local and set only what you need.
# Every variable below is OPTIONAL — the app builds and runs with none of them.
# All JSON processing happens in the browser; nothing is sent to a server.

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX.
# Optional. The Analytics component is a no-op unless this is set, so leaving it
# empty means no analytics script is loaded at all.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
